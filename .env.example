# Copy to `.env` — locally it is read by `next dev`, the worker and the
# Prisma CLI; on the server by docker compose. Never commit the real file.
# (An optional `.env.local` overrides `.env` for local-only values.)

# --- App / NextAuth ---------------------------------------------------------
NEXTAUTH_URL=http://localhost:3002
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Google OAuth -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- PostgreSQL -------------------------------------------------------------
# Docker only: the compose `db` service creates the database with this
# password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Docker:          postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/resume_screener
# Local (dev.yml): postgresql://postgres:postgres@localhost:5444/resume_screener
DATABASE_URL=postgresql://postgres:postgres@localhost:5444/resume_screener
# Optional, only for `prisma migrate dev`.
# SHADOW_DATABASE_URL=

# --- Redis (BullMQ queue) ---------------------------------------------------
# Docker: redis://redis:6379   Local (dev.yml): redis://localhost:6379
REDIS_URL=redis://localhost:6379
# Milliseconds before an idle worker disconnects, or `never` to stay connected.
WORKER_IDLE_TIMEOUT_MS=never
# Docker only: number of worker containers.
WORKER_REPLICAS=1

# --- Resume file storage ----------------------------------------------------
# Local only (default ./storage/resumes). Docker always uses the
# /data/resumes volume, set in docker-compose.yaml.
# RESUME_STORAGE_DIR=./storage/resumes

# --- AI provider (OpenAI-compatible) ----------------------------------------
AI_BASE_URL=
AI_API_KEY=

# --- Cloudflare Turnstile ---------------------------------------------------
# NEXT_PUBLIC_* is inlined at build time. Local `next dev`/`next build` read it
# from here; CI images take it from the repo variable of the same name.
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=
CLOUDFLARE_SECRET_KEY=

# --- SMTP (verification / magic-link emails) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Docker (server) ---------------------------------------------------------
# Host port nginx proxies to.
APP_PORT=3000
# Keeps volume names stable whatever the folder is called.
COMPOSE_PROJECT_NAME=ai-resume-screener
# Images pulled from ghcr.io/<GHCR_OWNER>/ai-resume-screener:<IMAGE_TAG>.
# GHCR_OWNER=ilhamdhiya01
# IMAGE_TAG=latest
